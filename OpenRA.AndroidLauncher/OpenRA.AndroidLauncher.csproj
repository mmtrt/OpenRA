<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>OpenRA.Android</RootNamespace>
    <ApplicationId>net.openra.android</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0-alpha</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AndroidMinSdkVersion>26</AndroidMinSdkVersion>
    <AndroidTargetSdkVersion>36</AndroidTargetSdkVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Release still runs the Android linker (SdkOnly). LINQ Max/etc must not be stripped. -->
    <AndroidLinkMode>None</AndroidLinkMode>
    <TrimMode>copyused</TrimMode>
    <RunAOTCompilation>false</RunAOTCompilation>
    <OpenRAAndroid>true</OpenRAAndroid>
  </PropertyGroup>

  <ItemGroup>
    <LinkDescription Include="Platforms\Android\linker.xml" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\OpenRA.Platforms.Android\OpenRA.Platforms.Android.csproj" AdditionalProperties="OpenRAAndroid=true" />
    <ProjectReference Include="..\OpenRA.Game\OpenRA.Game.csproj" AdditionalProperties="OpenRAAndroid=true" />
  </ItemGroup>

  <!-- SDL2 intentionally omitted: libSDL2.so JNI_OnLoad aborts without full org.libsdl.app.
       Prototype window/GL is AndroidEgl + GameSurfaceView. Re-add with real SDL Java later. -->
  <ItemGroup>
    <AndroidNativeLibrary Include="..\native\android\arm64-v8a\libopenal.so" />
    <AndroidNativeLibrary Include="..\native\android\arm64-v8a\libfreetype.so" />
    <AndroidNativeLibrary Include="..\native\android\arm64-v8a\liblua5.1.so" />
  </ItemGroup>

  <!-- Eluant DllImport("lua51") needs liblua51.so in the APK (alias of liblua5.1.so). -->
  <Target Name="AliasLua51" BeforeTargets="ResolveAssemblyReferences;_GetUserAssemblies;_ResolveNativeLibraries"
          Condition="Exists('$(MSBuildThisFileDirectory)..\native\android\arm64-v8a\liblua5.1.so')">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\native\android\arm64-v8a\liblua5.1.so"
          DestinationFiles="$(MSBuildThisFileDirectory)..\native\android\arm64-v8a\liblua51.so"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <AndroidNativeLibrary Include="$(MSBuildThisFileDirectory)..\native\android\arm64-v8a\liblua51.so"
                           Condition="Exists('$(MSBuildThisFileDirectory)..\native\android\arm64-v8a\liblua51.so')" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <AndroidJavaSource Include="Java\org\libsdl\app\*.java" />
  </ItemGroup>
</Project>
