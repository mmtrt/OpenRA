<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>OpenRA.Android</RootNamespace>
    <!-- OpenRAMod=ra|cnc|d2k|ts — one APK per mod (AppImage-style naming). -->
    <OpenRAMod Condition="'$(OpenRAMod)' == ''">ra</OpenRAMod>
    <ApplicationId>net.openra.android.$(OpenRAMod)</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0-alpha</ApplicationDisplayVersion>
    <ApplicationTitle Condition="'$(OpenRAMod)' == 'ra'">OpenRA Red Alert</ApplicationTitle>
    <ApplicationTitle Condition="'$(OpenRAMod)' == 'cnc'">OpenRA Tiberian Dawn</ApplicationTitle>
    <ApplicationTitle Condition="'$(OpenRAMod)' == 'd2k'">OpenRA Dune 2000</ApplicationTitle>
    <ApplicationTitle Condition="'$(OpenRAMod)' == 'ts'">OpenRA Tiberian Sun</ApplicationTitle>
    <ApplicationTitle Condition="'$(ApplicationTitle)' == ''">OpenRA</ApplicationTitle>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AndroidMinSdkVersion>26</AndroidMinSdkVersion>
    <AndroidTargetSdkVersion>36</AndroidTargetSdkVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);OPENRA_MOD_$([System.String]::Copy('$(OpenRAMod)').ToUpperInvariant())</DefineConstants>
    <!-- CRITICAL: PublishTrimmed=true strips BCL methods OpenRA needs when loading MIX/rules
         via dynamically loaded OpenRA.Mods.*.dll (MissingMethodException:
         MemoryExtensions.ToUpperInvariant, Array.Copy(long), Enumerable.Max, …).
         That makes every content|*.mix Mount fail → content installer loop forever.
         Keep false until a full trimmer descriptor covers OpenRA + System.Memory/Runtime. -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <OpenRAAndroid>true</OpenRAAndroid>
  </PropertyGroup>
<ItemGroup>
    <ProjectReference Include="..\OpenRA.Platforms.Android\OpenRA.Platforms.Android.csproj" AdditionalProperties="OpenRAAndroid=true" />
    <ProjectReference Include="..\OpenRA.Game\OpenRA.Game.csproj" AdditionalProperties="OpenRAAndroid=true" />
  </ItemGroup>

  <!-- SDL2 intentionally omitted: libSDL2.so JNI_OnLoad aborts without full org.libsdl.app.
       Prototype window/GL is AndroidEgl + GameSurfaceView. Re-add with real SDL Java later. -->
  <ItemGroup>
    <AndroidNativeLibrary Include="..\native\android\arm64-v8a\libopenal.so" />
    <AndroidNativeLibrary Include="..\native\android\arm64-v8a\libfreetype.so" />
    <AndroidNativeLibrary Include="..\native\android\arm64-v8a\liblua5.1.so" />
  </ItemGroup>

  <!-- Eluant DllImport("lua51") needs liblua51.so in the APK (alias of liblua5.1.so). -->
  <Target Name="AliasLua51" BeforeTargets="ResolveAssemblyReferences;_GetUserAssemblies;_ResolveNativeLibraries"
          Condition="Exists('$(MSBuildThisFileDirectory)..\native\android\arm64-v8a\liblua5.1.so')">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\native\android\arm64-v8a\liblua5.1.so"
          DestinationFiles="$(MSBuildThisFileDirectory)..\native\android\arm64-v8a\liblua51.so"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <AndroidNativeLibrary Include="$(MSBuildThisFileDirectory)..\native\android\arm64-v8a\liblua51.so"
                           Condition="Exists('$(MSBuildThisFileDirectory)..\native\android\arm64-v8a\liblua51.so')" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <AndroidJavaSource Include="Java\org\libsdl\app\*.java" />
  </ItemGroup>

  <!-- Preserve LINQ + OpenRA APIs used via reflection / dynamically loaded mod DLLs. -->
  <!-- Used only if PublishTrimmed is forced true (-p:PublishTrimmed=true). -->
  <ItemGroup>
    <TrimmerRootDescriptor Include="Platforms\Android\trimming.xml" />
    <TrimmerRootAssembly Include="System.Linq" RootMode="All" />
    <TrimmerRootAssembly Include="System.Memory" RootMode="All" />
    <TrimmerRootAssembly Include="System.Runtime" RootMode="All" />
    <TrimmerRootAssembly Include="System.Runtime.Extensions" RootMode="All" />
    <TrimmerRootAssembly Include="System.Collections" RootMode="All" />
  </ItemGroup>

  <!-- Per-mod app name + launcher icons (mods/*/icon-3x.png → mipmaps). -->
  <Target Name="ApplyModBranding" BeforeTargets="PrepareForBuild;_GenerateAndroidAssets">
    <PropertyGroup>
      <_Mod>$(OpenRAMod)</_Mod>
      <_Mod Condition="'$(_Mod)' == ''">ra</_Mod>
      <_AppName Condition="'$(_Mod)' == 'ra'">OpenRA Red Alert</_AppName>
      <_AppName Condition="'$(_Mod)' == 'cnc'">OpenRA Tiberian Dawn</_AppName>
      <_AppName Condition="'$(_Mod)' == 'd2k'">OpenRA Dune 2000</_AppName>
      <_AppName Condition="'$(_Mod)' == 'ts'">OpenRA Tiberian Sun</_AppName>
      <_AppName Condition="'$(_AppName)' == ''">OpenRA</_AppName>
      <_IconSrc>$(MSBuildThisFileDirectory)Resources\mod-icons\$(_Mod)</_IconSrc>
    </PropertyGroup>
    <Message Importance="high" Text="ApplyModBranding: mod=$(_Mod) name=$(_AppName)" />
    <WriteLinesToFile
        File="$(MSBuildThisFileDirectory)Resources\values\strings.xml"
        Lines="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;%0A&lt;resources&gt;%0A    &lt;string name=&quot;app_name&quot;&gt;$(_AppName)&lt;/string&gt;%0A&lt;/resources&gt;"
        Overwrite="true"
        Encoding="UTF-8" />
    <WriteLinesToFile
        File="$(MSBuildThisFileDirectory)Resources\drawable\ic_launcher_foreground.xml"
        Lines="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;%0A&lt;inset xmlns:android=&quot;http://schemas.android.com/apk/res/android&quot;%0A    android:drawable=&quot;@drawable/icon_$(_Mod)&quot;%0A    android:insetLeft=&quot;18%&quot;%0A    android:insetTop=&quot;18%&quot;%0A    android:insetRight=&quot;18%&quot;%0A    android:insetBottom=&quot;18%&quot; /&gt;"
        Overwrite="true"
        Encoding="UTF-8" />
    <Copy SourceFiles="$(_IconSrc)\mipmap-mdpi\appicon.png" DestinationFolder="$(MSBuildThisFileDirectory)Resources\mipmap-mdpi" SkipUnchangedFiles="false" Condition="Exists('$(_IconSrc)\mipmap-mdpi\appicon.png')" />
    <Copy SourceFiles="$(_IconSrc)\mipmap-hdpi\appicon.png" DestinationFolder="$(MSBuildThisFileDirectory)Resources\mipmap-hdpi" SkipUnchangedFiles="false" Condition="Exists('$(_IconSrc)\mipmap-hdpi\appicon.png')" />
    <Copy SourceFiles="$(_IconSrc)\mipmap-xhdpi\appicon.png" DestinationFolder="$(MSBuildThisFileDirectory)Resources\mipmap-xhdpi" SkipUnchangedFiles="false" Condition="Exists('$(_IconSrc)\mipmap-xhdpi\appicon.png')" />
    <Copy SourceFiles="$(_IconSrc)\mipmap-xxhdpi\appicon.png" DestinationFolder="$(MSBuildThisFileDirectory)Resources\mipmap-xxhdpi" SkipUnchangedFiles="false" Condition="Exists('$(_IconSrc)\mipmap-xxhdpi\appicon.png')" />
    <Copy SourceFiles="$(_IconSrc)\mipmap-xxxhdpi\appicon.png" DestinationFolder="$(MSBuildThisFileDirectory)Resources\mipmap-xxxhdpi" SkipUnchangedFiles="false" Condition="Exists('$(_IconSrc)\mipmap-xxxhdpi\appicon.png')" />
  </Target>
</Project>
