<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>OpenRA.Android</RootNamespace>
    <ApplicationId>net.openra.android</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0-alpha</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AndroidMinSdkVersion>26</AndroidMinSdkVersion>
    <AndroidTargetSdkVersion>36</AndroidTargetSdkVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <OpenRAAndroid>true</OpenRAAndroid>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenRA.Platforms.Android\OpenRA.Platforms.Android.csproj" AdditionalProperties="OpenRAAndroid=true" />
    <ProjectReference Include="..\OpenRA.Game\OpenRA.Game.csproj" AdditionalProperties="OpenRAAndroid=true" />
  </ItemGroup>

  <ItemGroup>
    <AndroidNativeLibrary Include="..\native\android\arm64-v8a\libSDL2.so" />
    <AndroidNativeLibrary Include="..\native\android\arm64-v8a\libopenal.so" />
    <AndroidNativeLibrary Include="..\native\android\arm64-v8a\libfreetype.so" />
    <AndroidNativeLibrary Include="..\native\android\arm64-v8a\liblua5.1.so" />
  </ItemGroup>
</Project>
