<?xml version="1.0" encoding="UTF-8"?>
<!-- Preserve LINQ overloads used by OpenRA.Mods.Common (HitShape, rules, etc.).
     MissingMethodException: Enumerable.Max<T>(IEnumerable<T>, Func<T,int>) is a
     classic symptom of the Android linker removing System.Linq methods. -->
<linker>
  <assembly fullname="System.Linq">
    <type fullname="System.Linq.Enumerable" preserve="all" />
  </assembly>
  <assembly fullname="System.Core">
    <type fullname="System.Linq.Enumerable" preserve="all" />
  </assembly>
  <assembly fullname="OpenRA.Mods.Common" preserve="all" />
  <assembly fullname="OpenRA.Mods.Cnc" preserve="all" />
  <assembly fullname="OpenRA.Game" preserve="all" />
</linker>
